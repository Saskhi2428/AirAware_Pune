# ---- Real data providers ----
# Register free at https://explore.openaq.org/register to get a key
OPENAQ_API_KEY=31ffaa2137590fa5c27909896e3869681605d81c94407eb3b7cd283b195537a0
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Register free at https://www.data.gov.in/user/register to get a key
# Resource: "Real time Air Quality Index" (CPCB), resource id below is fixed/public
CPCB_DATAGOVIN_API_KEY=579b464db66ec23bdd000001e8b2fbc62c4a44807e3fd86aec6f2d86
CPCB_DATAGOVIN_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
CPCB_BASE_URL=https://api.data.gov.in/resource

# Weather provider (Open-Meteo requires no key; keep as pluggable default)
WEATHER_PROVIDER=open_meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1
# If you switch to a keyed provider (e.g. OpenWeatherMap), set this:
WEATHER_API_KEY=

# ---- App ----
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Scheduling (minutes) — must respect provider rate limits ----
JOB_STATION_SYNC_INTERVAL_MIN=1440
JOB_LATEST_OBSERVATIONS_INTERVAL_MIN=15
JOB_WEATHER_INTERVAL_MIN=60
JOB_HOTSPOT_ANALYSIS_INTERVAL_MIN=180
JOB_ANOMALY_ANALYSIS_INTERVAL_MIN=60
JOB_DAILY_AGGREGATION_HOUR_UTC=20

# ---- Pune Metropolitan Region bounding box (PMC + PCMC + Cantonment) ----
# Deliberately generous so PCMC/Bhosari/Akurdi/Nigdi are not excluded.
PUNE_BBOX_MIN_LAT=18.35
PUNE_BBOX_MIN_LNG=73.65
PUNE_BBOX_MAX_LAT=18.80
PUNE_BBOX_MAX_LNG=74.05
