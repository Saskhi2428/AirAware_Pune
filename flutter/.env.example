# Copy to `.env` in the flutter/ folder. Only the ANON key goes here —
# NEVER put SUPABASE_SERVICE_ROLE_KEY in the Flutter app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Your FastAPI backend base URL
# Local dev (Android emulator uses 10.0.2.2 to reach host machine's localhost):
API_BASE_URL=http://10.0.2.2:8000/api/v1
# Production: https://your-backend-domain.com/api/v1
